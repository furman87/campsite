@model global::Campsite.Models.BookingInput
@{ var site = (global::Campsite.Models.Campsite)ViewBag.Site; ViewData["Title"] = "Complete your booking"; }
<section class="page-hero compact"><div class="eyebrow">ONE LAST STEP</div><h1>Make it official.</h1></section>
<section class="section reserve-layout"><aside><div class="site-art"><span>@site.SiteType</span></div><h2>@site.Name</h2><p>@site.Description</p><p><b>$@site.NightlyRate.ToString("0") / night</b></p></aside><form method="post" class="reserve-form"><input asp-for="CampsiteId" type="hidden" /><input asp-for="CheckIn" type="hidden" /><input asp-for="CheckOut" type="hidden" /><input asp-for="Guests" type="hidden" /><h2>Your details</h2><div asp-validation-summary="ModelOnly" class="validation"></div><label>Name <input asp-for="Name" autocomplete="name" /></label><label>Email <input asp-for="Email" autocomplete="email" /></label><label>Phone <input asp-for="Phone" autocomplete="tel" /></label><h3>Payment</h3><label class="radio"><input asp-for="PaymentMethod" type="radio" value="stripe" checked /> Credit or debit card</label><label class="radio"><input asp-for="PaymentMethod" type="radio" value="paypal" /> PayPal</label><p class="fine-print">You’ll finish securely with your chosen payment provider. We never see or store card numbers.</p><button class="button ember">Continue to payment →</button></form></section>
