@model global::Campsite.Models.Reservation
@{ ViewData["Title"] = "Reservation complete"; }
<section class="confirmation"><div class="eyebrow">@((bool)ViewBag.Paid ? "PAYMENT RECEIVED" : "PAYMENT PROCESSING")</div><h1>@((bool)ViewBag.Paid ? "You’re headed outside." : "We’re checking on that payment.")</h1><p>@((bool)ViewBag.Paid ? "Your reservation is confirmed and a receipt will arrive at " + Model?.CustomerEmail + "." : "Your reservation is saved. If payment did not finish, please return to booking or contact the office.")</p>@if (Model is not null) { <div class="confirmation-card"><span>Reservation #@Model.Id</span><h2>@Model.CampsiteName</h2><p>@Model.CheckIn.ToString("MMM dd, yyyy") — @Model.CheckOut.ToString("MMM dd, yyyy") · @Model.Guests guests</p><b>$@Model.Total.ToString("0.00")</b></div> }<a class="button dark" asp-controller="Home" asp-action="Index">Back to Lakeside Campground</a></section>
