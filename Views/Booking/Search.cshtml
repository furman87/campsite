@model global::Campsite.ViewModels.BookingViewModel
@{ ViewData["Title"] = "Book a stay"; }
<section class="page-hero compact"><div class="eyebrow">RESERVE YOUR SITE</div><h1>Find your place<br />under the pines.</h1></section>
<section class="booking-page section"><form class="search-form" method="get"><label>Arrival <input asp-for="Search.CheckIn" type="date" /></label><label>Departure <input asp-for="Search.CheckOut" type="date" /></label><label>Guests <input asp-for="Search.Guests" type="number" min="1" max="20" /></label><button class="button dark">Update search</button></form><div asp-validation-summary="ModelOnly" class="validation"></div><p class="result-count">@Model.Sites.Count campsite@(Model.Sites.Count == 1 ? "" : "s") ready for your stay.</p><div class="booking-results">@foreach (var site in Model.Sites) { <article class="result"><div class="site-art"><span>@site.SiteType</span></div><div><h2>@site.Name</h2><p>@site.Description</p><div class="site-meta"><span>Up to @site.MaxGuests guests</span><span>@(site.HasElectric ? "Electric hookup" : "Off-grid")</span></div></div><div class="result-price"><b>$@site.NightlyRate.ToString("0")</b><span>per night</span><a class="button ember" asp-action="Reserve" asp-route-siteId="@site.Id" asp-route-checkIn="@Model.Search.CheckIn" asp-route-checkOut="@Model.Search.CheckOut" asp-route-guests="@Model.Search.Guests">Reserve</a></div></article> }</div></section>
