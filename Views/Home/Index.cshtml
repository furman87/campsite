@model global::Campsite.ViewModels.HomeViewModel
@{ ViewData["Title"] = "A good kind of escape"; }
<section class="hero"><div class="eyebrow">LAKESIDE CAMPGROUND · EST. 1987</div><h1>Make room for<br /><i>lake days.</i></h1><p>Waterfront tent sites, peaceful RV spots and bright, unhurried weekends on the shore.</p><a class="button ember" asp-controller="Booking" asp-action="Search">Find a campsite <span>→</span></a><div class="hero-note"><b>4.9 / 5</b><span>from campers who came to unwind</span></div></section>
<section class="booking-strip" id="book"><form asp-controller="Booking" asp-action="Search" method="get"><label>Arrival <input type="date" name="CheckIn" required /></label><label>Departure <input type="date" name="CheckOut" required /></label><label>Guests <select name="Guests"><option value="2">2 guests</option><option value="4">4 guests</option><option value="6">6 guests</option><option value="8">8 guests</option></select></label><button class="button dark">Check availability</button></form></section>
<section class="section intro"><div><div class="eyebrow">STAY A LITTLE LONGER</div><h2>Make a home base<br />out of the great outdoors.</h2></div><p>Wake with the birds, fall asleep to a creek, and let the day take whatever shape it wants. Our sites give you the essentials—and leave room for the good stuff.</p></section>
<section class="sites section"><div class="section-head"><div><div class="eyebrow">PICK YOUR PATCH</div><h2>Sites made for settling in.</h2></div><a asp-controller="Booking" asp-action="Search">See all availability →</a></div><div class="card-grid">@foreach (var site in Model.Campsites) { <article class="site-card"><div class="site-art"><span>@site.SiteType</span></div><div class="site-card-body"><div><h3>@site.Name</h3><p>@site.Description</p></div><div class="site-meta"><span>Up to @site.MaxGuests guests</span><span>@(site.HasElectric ? "Electric hookup" : "Off-grid")</span></div><div class="price"><b>$@site.NightlyRate.ToString("0")</b> / night <a asp-controller="Booking" asp-action="Search">Explore →</a></div></div></article> }</div></section>
<section id="activities" class="section split-section"><div class="activity-panel"><div class="eyebrow">AROUND THE CAMPGROUND</div><h2>There’s always<br /><i>something stirring.</i></h2><p>Slow mornings, lively nights, and plenty of reasons to gather around.</p><a class="text-link" asp-controller="Home" asp-action="Rules">Hours &amp; campground info →</a></div><div class="activities">@foreach (var activity in Model.Activities) { <article><time><b>@activity.StartsAt.ToString("MMM dd")</b><span>@activity.StartsAt.ToString("h:mm tt")</span></time><div><h3>@activity.Title</h3><p>@activity.Description</p><small>⌖ @activity.Location</small></div></article> }</div></section>
<section id="menu" class="section food"><div><div class="eyebrow">THE LAKESIDE GRILL</div><h2>Something good<br />is on the fire.</h2><p>Easy campground favorites, made to order. Open Thu–Mon, 8 AM–8 PM.</p></div><div class="menu-list">@foreach (var item in Model.Menu) { <article><span>@item.Category</span><h3>@item.Name <b>$@item.Price.ToString("0.00")</b></h3><p>@item.Description</p></article> }</div></section>
<section class="cta"><div class="eyebrow">YOUR WEEKEND IS WAITING</div><h2>Go where the signal<br />gets a little softer.</h2><a class="button ember" asp-controller="Booking" asp-action="Search">Book your stay <span>→</span></a></section>
