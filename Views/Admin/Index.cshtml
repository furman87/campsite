@model global::Campsite.ViewModels.AdminViewModel
@{ ViewData["Title"] = "Campground admin"; }
<section class="admin-page"><header class="admin-header"><div><div class="eyebrow">ADMINISTRATION</div><h1>Good morning, @User.Identity?.Name.</h1></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="button light">Sign out</button></form></header><div class="stats"><article><span>Reservations</span><b>@Model.Reservations.Count</b></article><article><span>Customers</span><b>@Model.CustomerCount</b></article><article><span>Unpaid balance</span><b>$@Model.PendingRevenue.ToString("0.00")</b></article></div>
<section class="admin-section"><div class="section-head"><h2>Reservations &amp; payments</h2><span>Use status to manage arrivals, cancellations, and payment follow-up.</span></div><div class="table-wrap"><table><thead><tr><th>Guest</th><th>Site / stay</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead><tbody>@foreach (var r in Model.Reservations) { <tr><td><b>@r.CustomerName</b><small>@r.CustomerEmail</small></td><td>@r.CampsiteName<small>@r.CheckIn.ToString("MMM dd") – @r.CheckOut.ToString("MMM dd")</small></td><td>$@r.Total.ToString("0.00")</td><td><span class="pill @r.PaymentStatus.ToLowerInvariant()">@r.PaymentStatus</span><small>@r.PaymentMethod</small></td><td><form asp-action="Status" method="post"><input type="hidden" name="id" value="@r.Id" /><select name="status" onchange="this.form.submit()"><option selected="@(r.Status == "Pending")">Pending</option><option selected="@(r.Status == "Confirmed")">Confirmed</option><option selected="@(r.Status == "Cancelled")">Cancelled</option></select></form></td></tr> }</tbody></table></div></section>
<section class="admin-section"><div class="section-head"><h2>Customer directory</h2><span>Contact details captured during booking.</span></div><div class="table-wrap"><table><thead><tr><th>Guest</th><th>Email</th><th>Phone</th><th>Joined</th></tr></thead><tbody>@foreach (var customer in Model.Customers) { <tr><td><b>@customer.Name</b></td><td>@customer.Email</td><td>@customer.Phone</td><td>@customer.CreatedAt.ToString("MMM dd, yyyy")</td></tr> }</tbody></table></div></section>
<div class="admin-duo"><section class="admin-section"><h2>Activities</h2><form asp-action="AddActivity" method="post" class="admin-form"><input name="Title" placeholder="Activity name" required /><input name="StartsAt" type="datetime-local" required /><input name="Location" placeholder="Location" required /><textarea name="Description" placeholder="A short description" required></textarea><button class="button dark">Add activity</button></form><div class="manage-list">@foreach (var a in Model.Activities) { <div><span><b>@a.Title</b><small>@a.StartsAt.ToString("MMM dd · h:mm tt")</small></span><form asp-action="DeleteActivity" method="post"><input type="hidden" name="id" value="@a.Id" /><button class="delete">Remove</button></form></div> }</div></section>
<section class="admin-section"><h2>Restaurant menu</h2><p class="admin-help">Menu items appear from lowest to highest display order. Leave gaps (10, 20, 30) to make future inserts easy.</p><form asp-action="AddMenu" method="post" class="admin-form"><input name="Category" placeholder="Category" required /><input name="Name" placeholder="Menu item" required /><input name="Price" type="number" step="0.01" min="0" placeholder="Price" required /><input name="SortOrder" type="number" min="1" value="@(Model.Menu.Count == 0 ? 10 : Model.Menu.Max(x => x.SortOrder) + 10)" aria-label="Display order" required /><textarea name="Description" placeholder="Description" required></textarea><button class="button dark">Add menu item</button></form><div class="manage-list">@foreach (var item in Model.Menu) { <div><span><b>@item.Name · $@item.Price.ToString("0.00")</b><small>@item.Category</small></span><form asp-action="UpdateMenuOrder" method="post" class="menu-order-form"><input type="hidden" name="id" value="@item.Id" /><label>Order <input type="number" name="sortOrder" min="1" value="@item.SortOrder" /></label><button class="order-save">Save</button></form><form asp-action="DeleteMenu" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="delete">Remove</button></form></div> }</div></section></div>
<section class="admin-section theme-section"><h2>Brand colors</h2><p>Change your campground’s visual palette. Use the color pickers or edit each hex value.</p><form asp-action="Theme" method="post" class="theme-form">@foreach (var pair in new[] { ("Primary", Model.Theme.Primary), ("Forest", Model.Theme.Forest), ("Earth", Model.Theme.Earth), ("Sand", Model.Theme.Sand), ("Ember", Model.Theme.Ember) }) { <label>@pair.Item1<input type="color" name="@pair.Item1" value="@pair.Item2" /><input name="@pair.Item1" value="@pair.Item2" pattern="#[0-9a-fA-F]{6}" /></label> }<button class="button ember">Save colors</button></form></section></section>
